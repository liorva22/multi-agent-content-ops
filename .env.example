# 1 = deterministic offline agents (no keys). 0 = Claude agents (Sonnet / Opus / Haiku per config.yaml).
MOCK_MODE=1
# Required only when MOCK_MODE=0.
ANTHROPIC_API_KEY=
# Postgres DSN for per-step logging. docker compose sets this for you.
DATABASE_URL=
# Optional: alternative config.yaml (models, prices, retry limit, rubric thresholds).
CONTENTOPS_CONFIG=
# Host ports under docker compose.
API_PORT=8104
DB_PORT=5436
